# GlanceOS server configuration. Copy to `.env` (or set in your process manager /
# container). Everything has a sensible default — a bare `pnpm start` just works.
# The server validates these at boot and fails fast on a broken value.

# --- core ---
PORT=8080                         # HTTP port the server listens on
GLANCEOS_DATA_DIR=./apps/server/data   # SQLite DB + uploads + the auto secret.key live here
# GLANCEOS_PUBLIC_URL=https://glance.example   # public origin behind a proxy (OAuth redirects, share/QR links)
# GLANCEOS_CAST_APP_ID=ABCD1234     # your registered Google Cast receiver App ID → enables "Cast to TV" (and widens CSP to gstatic)
# GLANCEOS_REGISTRATION=closed     # set to "closed" to block new sign-ups (the first user is always allowed)

# --- secrets (AES-256-GCM at rest) ---
# GLANCEOS_SECRET_KEY=<long-random-string>   # if unset, a 0600 data/secret.key is generated
# GLANCEOS_SECRET_KEY_PREVIOUS=<old-key>     # during a key rotation; drop after `pnpm rotate-secrets`
# GLANCEOS_KEY_VERSION=1           # bump when you rotate the key (records which key sealed each row)

# --- security / networking ---
# GLANCEOS_TRUSTED_PROXIES=127.0.0.1   # comma-separated proxy IPs to trust x-forwarded-for from ("*" = any)
# GLANCEOS_ALLOW_PRIVATE_EGRESS=1  # disable the SSRF guard (only on a fully trusted LAN)
# GLANCEOS_RATE_LIMIT=off          # disable in-memory rate limiting (tests / trusted LANs)

# --- email (transactional + lifecycle; inert until one backend is set) ---
# RESEND_API_KEY=re_xxx           # send via Resend's HTTP API (no extra deps)
# SMTP_HOST=smtp.example.com      # OR send via SMTP — needs `pnpm --filter @glanceos/server add nodemailer`
# SMTP_PORT=587                   # 465 ⇒ implicit TLS; otherwise STARTTLS
# SMTP_SECURE=1                   # force implicit TLS regardless of port
# SMTP_USER=apikey                # SMTP auth (omit for an open relay on a trusted network)
# SMTP_PASS=<password>
# GLANCEOS_EMAIL_FROM="GlanceOS <noreply@glance.example>"   # From: header on outgoing mail

# --- ops ---
# GLANCEOS_LOG=json                # opt-in structured JSON request logging
# GLANCEOS_UPLOAD_QUOTA_MB=50      # per-user upload quota (0 blocks all uploads)
# GLANCEOS_GC_UNREFERENCED_UPLOADS=1   # also reclaim upload rows referenced by no board
# GLANCEOS_LOW_BATTERY_PCT=20      # device low-battery alert threshold
# GLANCEOS_OFFLINE_MINUTES=15      # minutes without contact before a device is "offline"
